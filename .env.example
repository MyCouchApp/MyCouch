# Optional environment variables.
# The Plex database can also be selected from Settings after first launch.
PLEX_DB=C:\Users\YOUR_USER\AppData\Local\Plex Media Server\Plug-in Support\Databases\com.plexapp.plugins.library.db

# Optional fixed Flask session secret. If omitted, MyCouch creates/uses .pla-secret.
# MYCOUCH_SECRET=replace-with-a-long-random-value

# Set to 1 only when MyCouch is served over HTTPS.
MYCOUCH_SECURE_COOKIE=0
